# Copy to .env.local and adjust.

# Base URL of Keco Studio (for embedding project library UI in simulation, e.g. /simulation-system/battle/studio-libraries).
NEXT_PUBLIC_KECO_STUDIO_ORIGIN=http://localhost:3000

# Optional: same Supabase project as Keco Studio when using copied studio-lib UI on studio-libraries routes.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
